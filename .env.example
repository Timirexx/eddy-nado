# --- Wallet connection (client-side, not secret) ---
# Free project ID from https://cloud.reown.com (formerly WalletConnect Cloud).
# Required for QR-code and mobile wallets; browser-extension wallets work without it.
# This ships in the browser bundle by design — it is an identifier, not a credential.
VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here

# --- AI assistant (server-side, SECRET) ---
# API key from https://console.anthropic.com/settings/keys
# Used only by the serverless function in /api. Note there is no VITE_ prefix:
# any VITE_-prefixed variable is inlined into the browser bundle, which would
# publish the key to every visitor. Never rename this one.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Rate limiting (optional; sensible defaults if unset) ---
# /api/chat is public and every call spends tokens, so it is limited per client.
# RATE_LIMIT_MAX=15                 # messages allowed per window per IP
# RATE_LIMIT_WINDOW_SECONDS=300     # window length
# RATE_LIMIT_DAILY_GLOBAL=500       # optional ceiling across ALL callers per UTC
#                                   # day — the backstop against IP rotation.
#                                   # Unset means no global cap.

# Counting is per serverless instance unless a shared store is configured.
# Create a KV/Redis store in the Vercel dashboard and these get injected
# automatically; the limiter then enforces the numbers above exactly, with no
# code change. Without them it still throttles, just more loosely.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
